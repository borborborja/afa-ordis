# Application
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_DOMAIN=localhost
APP_BASE_URL=https://localhost
TIME_ZONE=Europe/Madrid
APP_IMAGE=ghcr.io/borborborja/afa-ordis
APP_IMAGE_TAG=latest
RUN_SCHEDULER=true

# Initial platform account. It is created only when the database is empty.
BOOTSTRAP_SUPERUSER=true
SUPERUSER_EMAIL=your-email@example.com
SUPERUSER_PASSWORD=replace-with-a-strong-password
SUPERUSER_NAME=Administrador AFA

# Persistent SQLite database. Do not use multiple app replicas with this mode.
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=/data/afa-ordis.sqlite3

# SMTP. Use SMTP_USE_TLS=true for port 587, or false for an unauthenticated local relay.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=Menjador AFA Ordis <menjador@example.com>
