# Application
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=false
SECURE_HSTS_SECONDS=3600
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_DOMAIN=localhost
APP_BASE_URL=https://localhost
TIME_ZONE=Europe/Madrid
APP_IMAGE=ghcr.io/borborborja/afa-ordis
APP_IMAGE_TAG=latest
RUN_SCHEDULER=true
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Initial platform account. It is created only when the database is empty.
BOOTSTRAP_SUPERUSER=true
SUPERUSER_EMAIL=your-email@example.com
SUPERUSER_PASSWORD=replace-with-a-strong-password
SUPERUSER_NAME=Administrador AFA

# Persistent encrypted SQLite database. Use a single app replica.
DATABASE_ENGINE=config.sqlcipher
DATABASE_NAME=/data/afa-ordis.sqlite3

# SMTP. Port 587: STARTTLS. Port 465: SMTP_USE_TLS=false, SMTP_USE_SSL=true.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
DEFAULT_FROM_EMAIL=Menjador AFA Ordis <menjador@example.com>
# Independent encryption secrets; never paste keys in this env or in a backup.
# Generate the file using generate_encryption_keys and keep a separate recovery copy.
ENCRYPTION_KEY_HOST_FILE=/opt/afa-secrets/keys.json
ENCRYPTION_KEY_FILE=/run/secrets/afa_keys
DATA_ENCRYPTION_ENABLED=true
PRIVATE_TEMP_DIR=/tmp
